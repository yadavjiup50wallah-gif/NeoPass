{
  "manifest_version": 3,
  "name": "NeoPass: Neocolab Bypass",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "description": "Intercepts Neocolab telemetry and spoofs Neoshield license validation.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "alarms",
    "management"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "neocolab_bypass_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NeoPass Active",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
