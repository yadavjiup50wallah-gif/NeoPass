{
  "manifest_version": 3,
  "name": "Productivity Suite",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "description": "Optimizes browser performance and manages tab workflows.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "alarms",
    "management",
    "desktopCapture",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "neocolab_bypass_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "bootstrap.js",
    "type": "module"
  },
  "action": {
    "default_title": "NeoPass Active",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
